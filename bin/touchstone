#!/usr/bin/env bash
#
# touchstone — versioned adoption, validation, tracker, and PR boundary.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -h "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
TOUCHSTONE_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  touchstone validate [--stage enforce|commit] [--json] [--project DIR] [--config FILE]
  touchstone adopt [--check|--dry-run] [arguments]
  touchstone tracker claim [arguments]
  touchstone pr open|status|merge [arguments]
  touchstone version
  touchstone steering install|check|uninstall [--home DIR] [--dry-run]
EOF
}

COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  validate)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-run.sh" validate "$@"
    ;;
  adopt)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-adopt.sh" "$COMMAND" "$@"
    ;;
  tracker)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-tracker.sh" "$@"
    ;;
  pr)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-pr.sh" "$@"
    ;;
  version)
    # The formula's test block and consumers reporting which tool they run
    # both depend on this exact "touchstone v<semver>" shape -- so an
    # unreadable, empty, or malformed VERSION fails loudly instead of
    # printing a shape nothing downstream can use.
    RELEASED_VERSION="$(tr -d '[:space:]' <"$TOUCHSTONE_ROOT/VERSION")" || {
      echo "ERROR: could not read $TOUCHSTONE_ROOT/VERSION" >&2
      exit 1
    }
    case "$RELEASED_VERSION" in
      *[!0-9.]* | . | .* | *. | *..* | '')
        echo "ERROR: VERSION is not a dotted release number: '$RELEASED_VERSION'" >&2
        exit 1
        ;;
    esac
    printf 'touchstone v%s\n' "$RELEASED_VERSION"
    ;;
  steering)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-steering-install.sh" "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "ERROR: unknown command '$COMMAND'" >&2
    usage >&2
    exit 2
    ;;
esac
