#!/usr/bin/env bash
#
# touchstone — CLI for the shared engineering starter kit.
#
# Usage:
#   touchstone new <project-dir>          Create a new project with touchstone files
#   touchstone init [--no-setup] [--type node|python|swift|rust|go|generic|auto]
#                                      Add touchstone to the current project
#   touchstone run <task>                  Run profile task: lint, test, build, typecheck, validate
#   touchstone preflight                   Run deterministic review preflight checks
#   touchstone update                     Update current project to latest touchstone
#   touchstone update --in-place          Update on the current branch
#   touchstone update --dry-run           Show what would change without applying
#   touchstone update --check             Report whether current project needs update
#   touchstone update --ship              Push, open PR, review, and auto-merge
#   touchstone update-all                 Update all registered projects
#   touchstone update-all --ship          Ship registered project updates through PRs
#   touchstone update-all --pull-first    Pull latest touchstone, then update all projects
#   touchstone sync                       Deprecated alias for update-all
#   touchstone status                     Show status of the current project
#   touchstone status --all               Show version distribution across registered projects
#   touchstone version                    Show installed version
#   touchstone --version                  Show installed version
#   touchstone doctor                     Check project or installation health
#   touchstone help                       Show this help
#
# Install:
#   brew tap autumngarage/touchstone
#   brew install touchstone
#
set -euo pipefail

# Resolve TOUCHSTONE_ROOT — works whether installed via brew symlink or clone.
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -h "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
TOUCHSTONE_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
export TOUCHSTONE_ROOT

touchstone_root_is_checkout() {
  local root top
  root="$(cd "$TOUCHSTONE_ROOT" 2>/dev/null && pwd -P)" || return 1
  top="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$top" ] || return 1
  top="$(cd "$top" 2>/dev/null && pwd -P)" || return 1
  [ "$top" = "$root" ]
}

# Source shared libraries.
source "$TOUCHSTONE_ROOT/lib/auto-update.sh"
source "$TOUCHSTONE_ROOT/lib/colors.sh"
source "$TOUCHSTONE_ROOT/lib/ui.sh"
source "$TOUCHSTONE_ROOT/lib/claude-md-touchstone-ref.sh"
source "$TOUCHSTONE_ROOT/lib/status.sh"
# shellcheck source=../lib/install-hooks.sh
source "$TOUCHSTONE_ROOT/lib/install-hooks.sh"
# shellcheck source=../lib/legacy-toolkit.sh
source "$TOUCHSTONE_ROOT/lib/legacy-toolkit.sh"

# Auto-update check (throttled, non-blocking on failure). When an update
# succeeds, re-exec so the current command runs against the upgraded files.
touchstone_auto_update_status=0
touchstone_auto_update || touchstone_auto_update_status=$?
if [ "$touchstone_auto_update_status" = "${TOUCHSTONE_AUTO_UPDATE_REEXEC_EXIT:-75}" ]; then
  touchstone_reexec_path="${TOUCHSTONE_AUTO_UPDATE_REEXEC_PATH:-$SCRIPT_PATH}"
  if [ -n "$touchstone_reexec_path" ] && [ -x "$touchstone_reexec_path" ]; then
    TOUCHSTONE_AUTO_UPDATE_REEXECED=1 exec "$touchstone_reexec_path" "$@"
  fi
  echo "WARNING: touchstone updated but could not re-exec upgraded CLI; continuing with current process." >&2
fi

# Helper: get touchstone version string.
touchstone_version_str() {
  cat "$TOUCHSTONE_ROOT/VERSION" 2>/dev/null | tr -d '[:space:]'
}

# Helper: get touchstone identifier for comparison (git SHA or version).
touchstone_current_id() {
  if touchstone_root_is_checkout; then
    git -C "$TOUCHSTONE_ROOT" rev-parse HEAD
  else
    touchstone_version_str
  fi
}

touchstone_current_id_short() {
  if touchstone_root_is_checkout; then
    git -C "$TOUCHSTONE_ROOT" rev-parse --short HEAD
  else
    touchstone_version_str
  fi
}

# --------------------------------------------------------------------------
# Subcommands
# --------------------------------------------------------------------------

cmd_new() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: touchstone new <project-dir> [--no-register] [--type node|python|swift|rust|go|generic|auto] [--gitbutler|--no-gitbutler] [--ci github|--no-ci] [--scaffold-tests]" >&2
    exit 1
  fi
  case "${1:-}" in
    -h|--help)
      echo "Usage: touchstone new <project-dir> [--no-register] [--type node|python|swift|rust|go|generic|auto] [--gitbutler|--no-gitbutler] [--gitbutler-mcp|--no-gitbutler-mcp] [--ci github|--no-ci] [--scaffold-tests]"
      return 0
      ;;
  esac
  exec bash "$TOUCHSTONE_ROOT/bootstrap/new-project.sh" "$@"
}

cmd_init() {
  # Init the current directory — bootstrap + setup in one command.
  local run_setup=true
  local setup_existed=false
  local ship_upgrade=true
  local claude_principles_mode="prompt"
  local args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-setup)
        run_setup=false
        shift
        ;;
      --ship)
        ship_upgrade=true
        shift
        ;;
      --no-ship)
        ship_upgrade=false
        shift
        ;;
      -h|--help)
        echo "Usage: touchstone init [--no-setup] [--type node|python|swift|rust|go|generic|auto] [--no-register] [--gitbutler|--no-gitbutler] [--gitbutler-mcp|--no-gitbutler-mcp] [--ci github|--no-ci] [--scaffold-tests] [--claude-principles yes|no|prompt] [--no-claude-principles]"
        return 0
        ;;
      --type)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: --type requires a value (node, python, swift, rust, go, generic, auto)" >&2
          exit 1
        fi
        args+=("$1" "$2")
        shift 2
        ;;
      --no-register)
        args+=("$1")
        shift
        ;;
      --unsafe-paths|--reviewer|--local-review-command|--review-routing|--small-review-lines)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: $1 requires a value" >&2
          exit 1
        fi
        echo "WARNING: $1 is retired and ignored; GitHub Codex PR review is mandatory." >&2
        shift 2
        ;;
      --git-workflow)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: $1 requires a value" >&2
          exit 1
        fi
        args+=("$1" "$2")
        shift 2
        ;;
      --ci)
        # --ci may stand alone (defaults to github) or take a value.
        if [ "$#" -ge 2 ] && [[ "$2" != --* ]]; then
          args+=("$1" "$2")
          shift 2
        else
          args+=("$1")
          shift
        fi
        ;;
      --no-ai-review|--no-review|--review-assist|--no-review-assist|--review-autofix|--no-review-autofix)
        echo "WARNING: $1 is retired and ignored; GitHub Codex PR review is mandatory." >&2
        shift
        ;;
      --gitbutler|--no-gitbutler|--gitbutler-mcp|--no-gitbutler-mcp|--no-ci|--scaffold-tests)
        args+=("$1")
        shift
        ;;
      --claude-principles)
        if [ "$#" -lt 2 ]; then
          echo "ERROR: --claude-principles requires a value (yes, no, or prompt)" >&2
          exit 1
        fi
        case "$2" in
          yes|no|prompt) claude_principles_mode="$2" ;;
          *)
            echo "ERROR: --claude-principles must be 'yes', 'no', or 'prompt' (got '$2')" >&2
            exit 1
            ;;
        esac
        shift 2
        ;;
      --no-claude-principles)
        claude_principles_mode="no"
        shift
        ;;
      *)
        echo "ERROR: unknown argument '$1'" >&2
        echo "Usage: touchstone init [--no-setup] [--type node|python|swift|rust|go|generic|auto] [--no-register] [--gitbutler|--no-gitbutler] [--ci github|--no-ci] [--scaffold-tests] [--claude-principles yes|no|prompt] [--no-claude-principles]" >&2
        exit 1
        ;;
    esac
  done

  if [ -e "$(pwd)/setup.sh" ]; then
    setup_existed=true
  fi

  # State detection: fresh | current | outdated | legacy-toolkit. Determines
  # whether init bootstraps or reconciles files in place.
  local project_dir installed_id current_id init_state="fresh"
  project_dir="$(pwd)"

  if [ -f "$project_dir/.toolkit-version" ] && [ -f "$project_dir/.touchstone-version" ]; then
    tk_fail "Migration conflict: both .toolkit-version and .touchstone-version are present in $project_dir"
    tk_dim "  Fix: rm .toolkit-version   (touchstone has already been installed here)"
    return 1
  elif [ -f "$project_dir/.toolkit-version" ]; then
    init_state="legacy-toolkit"
  elif [ -f "$project_dir/.touchstone-version" ]; then
    installed_id="$(cat "$project_dir/.touchstone-version" 2>/dev/null | tr -d '[:space:]' || echo "")"
    current_id="$(touchstone_current_id)"
    # Pass the tree so init consults the same content verdict as status,
    # doctor, update and auto-sync — a content-current project with a
    # differing stamp otherwise entered the outdated reconciliation flow
    # while status called it current (PR #787 review, round 3).
    if [ "$(_status_behind_count "$installed_id" "$current_id" "$project_dir")" = "current" ]; then
      init_state="current"
    else
      init_state="outdated"
    fi
  fi

  case "$init_state" in
    legacy-toolkit)
      tk_fail "Legacy .toolkit-version found in $project_dir"
      local legacy_step
      while IFS= read -r legacy_step; do
        tk_dim "$legacy_step"
      done < <(touchstone_legacy_toolkit_migration_steps "touchstone init")
      return 1
      ;;
    outdated)
      tk_header "Touchstone init — reconciling"
      tk_dim "  installed: ${installed_id:0:12}"
      tk_dim "  current:   ${current_id:0:12}"
      tk_info "This repo is on an older Touchstone; init will reconcile files in place."
      if [ "$ship_upgrade" = true ]; then
        tk_dim "For a reviewable branch + PR instead, run: touchstone update --ship"
      else
        tk_dim "For a reviewable branch + commit instead, run: touchstone update"
      fi
      echo ""
      # `init` is a repair/reconcile command, so it must not silently switch
      # branches or create orphaned PRs when the project is stale. The
      # reviewable update flow remains available as `touchstone update`.
      ;;
  esac

  # Fresh init: greet with the branded hero so setup feels like setup.
  tk_hero "setting up this project"

  bash "$TOUCHSTONE_ROOT/bootstrap/new-project.sh" "$project_dir" ${args[@]+"${args[@]}"}

  # Connect CLAUDE.md (or record that we already are). new-project.sh's
  # template copy plants the imports on a fresh init, so this normally
  # records `connected` without prompting. The interesting case is `current`
  # state on a project whose user wrote their own CLAUDE.md without imports
  # — then we prompt.
  ensure_claude_touchstone_ref "$project_dir" "$claude_principles_mode"

  # Only fresh init runs setup.sh automatically. Reconciling an existing repo
  # must not re-trigger machine-wide dev-tool installs or interactive prompts
  # just because the user happened to delete setup.sh before re-running init.
  if [ "$init_state" = "fresh" ] && [ "$run_setup" = true ] && [ -f "$project_dir/setup.sh" ]; then
    if [ "$setup_existed" = true ]; then
      tk_warn "setup.sh already existed, so touchstone left it in place and did not run it."
      tk_dim "Run manually if desired: bash setup.sh"
      return 0
    fi
    echo ""
    bash "$project_dir/setup.sh"
  fi
}

cmd_update() {
  exec bash "$TOUCHSTONE_ROOT/bootstrap/update-project.sh" "$@"
}

cmd_update_all() {
  exec bash "$TOUCHSTONE_ROOT/bootstrap/sync-all.sh" "$@"
}

cmd_retired_review() {
  echo "WARNING: touchstone review is retired; running deterministic preflight instead." >&2
  echo "         Semantic review is requested automatically after scripts/open-pr.sh pushes the PR." >&2
  cmd_preflight
}

cmd_retired_review_stats() {
  echo "WARNING: touchstone review-stats is retired; local model-review metrics no longer exist." >&2
  echo "         Inspect PR review state with: gh pr view --comments" >&2
}

cmd_retired_review_migration() {
  echo "WARNING: touchstone migrate-review-config is retired." >&2
  echo "         Touchstone reads legacy .codex-review.toml policy during migration." >&2
  echo "         Compare with templates/touchstone-review.toml and migrate through a normal PR." >&2
}

cmd_sync() {
  echo "DEPRECATED: touchstone sync is deprecated; use touchstone update-all." >&2
  cmd_update_all "$@"
}

cmd_run() {
  exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-run.sh" "$@"
}

cmd_preflight() {
  exec bash "$TOUCHSTONE_ROOT/lib/preflight.sh" "$@"
}

# Is $2 (current) >= $1 (required)? Both are dotted semver, with an
# optional leading "v". Nonzero when either side is unparseable, so a
# malformed release tag never reads as "you are current".
touchstone_version_at_least() {
  local required="${1#v}" current="${2#v}"
  awk -v required="$required" -v current="$current" '
    function parse_version(version, parts, count, i) {
      count = split(version, parts, ".")
      if (count < 2 || count > 3) {
        return 0
      }
      for (i = 1; i <= count; i++) {
        if (parts[i] !~ /^[0-9]+$/) {
          return 0
        }
        parts[i] += 0
      }
      for (i = count + 1; i <= 3; i++) {
        parts[i] = 0
      }
      return 1
    }

    BEGIN {
      if (!parse_version(required, req) || !parse_version(current, cur)) {
        exit 1
      }
      for (i = 1; i <= 3; i++) {
        if (cur[i] > req[i]) {
          exit 0
        }
        if (cur[i] < req[i]) {
          exit 1
        }
      }
      exit 0
    }'
}

cmd_detect() {
  exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-run.sh" detect
}

cmd_version() {
  local version
  version="$(touchstone_version_str)"
  tk_header "touchstone v${version:-unknown}"

  if command -v brew >/dev/null 2>&1 && brew list touchstone &>/dev/null; then
    tk_dim "installed via: brew"
    tk_dim "prefix: $(brew --prefix touchstone 2>/dev/null || echo unknown)"
  elif git -C "$TOUCHSTONE_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tk_dim "installed via: git clone"
    tk_dim "path: $TOUCHSTONE_ROOT"
    tk_dim "commit: $(git -C "$TOUCHSTONE_ROOT" rev-parse --short HEAD 2>/dev/null)"
  fi

  local projects_file="$HOME/.touchstone-projects"
  if [ -f "$projects_file" ]; then
    local count
    count="$(grep -c '[^[:space:]]' "$projects_file" 2>/dev/null || echo 0)"
    tk_dim "projects: $count registered"
  fi
}

cmd_status() {
  # Two views, one entrypoint:
  #   touchstone status         -> single-project block for $(pwd)
  #   touchstone status --all   -> registry walk with the version-distribution table
  #
  # This intentionally narrows the old `touchstone status` (which always
  # walked the registry). The registry view moves to `--all` so the bare
  # command is useful inside any one project — the more common ask. The
  # old behavior remains reachable via `--all`; `touchstone list` is
  # the registry-only listing without the version-distribution math.
  local mode="project"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all|-a) mode="all"; shift ;;
      -h|--help)
        echo "Usage: touchstone status [--all]"
        echo "  (no flag)  Show status for the current working directory"
        echo "  --all      Show version distribution across registered projects"
        return 0
        ;;
      *) echo "ERROR: unknown argument '$1'" >&2; exit 1 ;;
    esac
  done

  if [ "$mode" = "all" ]; then
    status_print_all
    return $?
  fi

  status_print_project "$(pwd)"
}

touchstone_doctor_pr_review_policy_valid() {
  local config_file="$1"
  local required="" request_on_push="" provider=""

  [ -f "$TOUCHSTONE_ROOT/lib/toml.sh" ] || return 1
  # shellcheck source=../lib/toml.sh
  source "$TOUCHSTONE_ROOT/lib/toml.sh"

  touchstone_doctor_review_policy_callback() {
    local section="$1" key="$2" value="$3"
    [ "$section" = "review.pr_triggered" ] || return 0
    case "$key" in
      required) required="$value" ;;
      request_on_push) request_on_push="$value" ;;
      provider) provider="$value" ;;
    esac
  }

  toml_parse "$config_file" touchstone_doctor_review_policy_callback
  [ "$required" = "true" ] || return 1
  [ "$request_on_push" = "true" ] || return 1
  [ "$provider" = "github-codex" ]
}

cmd_doctor_project() {
  local project_dir issues=0
  project_dir="$(touchstone_find_project_root 2>/dev/null || pwd)"

  tk_header "Touchstone Project Doctor — $(basename "$project_dir")"

  # 1. Is this a touchstone-managed project? Reject migration-conflict state first —
  # a project with both files is mid-migration and must not be reported healthy.
  if [ -f "$project_dir/.toolkit-version" ] && [ -f "$project_dir/.touchstone-version" ]; then
    tk_fail "Migration conflict: both .toolkit-version and .touchstone-version present"
    tk_dim "  Fix: rm .toolkit-version   (touchstone has already been installed)"
    echo ""
    return 1
  fi
  if [ ! -f "$project_dir/.touchstone-version" ]; then
    if [ -f "$project_dir/.toolkit-version" ]; then
      tk_fail "Legacy .toolkit-version found"
      local legacy_step
      while IFS= read -r legacy_step; do
        tk_dim "  $legacy_step"
      done < <(touchstone_legacy_toolkit_migration_steps "touchstone init")
      echo ""
      return 1
    fi
    tk_fail "Not a touchstone project (no .touchstone-version)"
    tk_dim "  Fix: touchstone init"
    echo ""
    return 1
  fi

  local installed_id current_id
  installed_id="$(cat "$project_dir/.touchstone-version" 2>/dev/null | tr -d '[:space:]' || echo "")"
  current_id="$(touchstone_current_id)"
  # Same verdict as every other surface (PR #787 review, round 3).
  if [ "$(_status_behind_count "$installed_id" "$current_id" "$project_dir")" = "current" ]; then
    tk_ok "touchstone version matches: ${installed_id:0:12}"
  else
    tk_warn "touchstone out of date (installed ${installed_id:0:12}, current ${current_id:0:12})"
    tk_dim "  Fix: touchstone update"
    issues=$((issues + 1))
  fi

  # 2. Git hooks installed? This is the footgun that silently ungates a repo.
  # Verify three separate failure modes because Git silently no-ops on any of them:
  #   - file absent → hook never runs
  #   - file present but not executable → Git skips it (same effect as absent)
  #   - file executable but not the pre-commit-framework shim → another hook
  #     framework replaced it; pushes proceed without deterministic validation.
  if [ ! -f "$project_dir/.pre-commit-config.yaml" ]; then
    tk_warn ".pre-commit-config.yaml is missing"
    tk_dim "  Fix: touchstone init  (reconciles missing templates)"
    issues=$((issues + 1))
  else
    local pre_commit_hook="" pre_push_hook="" hook_paths_resolved=true
    pre_commit_hook="$(touchstone_git_hook_path "$project_dir" pre-commit)" || hook_paths_resolved=false
    pre_push_hook="$(touchstone_git_hook_path "$project_dir" pre-push)" || hook_paths_resolved=false
    if [ "$hook_paths_resolved" != true ]; then
      tk_fail "could not resolve Git hook paths — repo gating cannot be verified"
      tk_dim "  Fix: verify this is a Git worktree, then rerun touchstone doctor --project"
      issues=$((issues + 1))
    elif [ -f "$pre_commit_hook" ] && [ -f "$pre_push_hook" ]; then
      if [ ! -x "$pre_commit_hook" ] || [ ! -x "$pre_push_hook" ]; then
        tk_fail "git hooks exist but are not executable — Git will skip them, repo is ungated"
        tk_dim "  Fix: chmod +x \"$pre_commit_hook\" \"$pre_push_hook\""
        issues=$((issues + 1))
      elif touchstone_pre_commit_hook_ready "$pre_push_hook" pre-push \
           && touchstone_pre_commit_hook_ready "$pre_commit_hook" pre-commit; then
        tk_ok "git hooks installed ($pre_commit_hook, $pre_push_hook)"
      else
        tk_warn "git hook files exist but aren't typed pre-commit-framework shims"
        tk_dim "  Another framework may have replaced them, or a shim was copied"
        tk_dim "  into the wrong hook slot (it would run the wrong --hook-type)."
        tk_dim "  Fix: pre-commit install --hook-type pre-commit --hook-type pre-push"
        issues=$((issues + 1))
      fi
    else
      tk_fail "git hooks NOT installed — repo is ungated"
      if command -v pre-commit >/dev/null 2>&1; then
        tk_dim "  Fix: touchstone init   (idempotent — reinstalls missing hooks)"
      else
        tk_dim "  Fix: brew install pre-commit && touchstone init"
      fi
      issues=$((issues + 1))
    fi
  fi

  # 2b. Legacy setup.sh hook reset. setup.sh is project-owned after bootstrap,
  # so the template fix that stopped unsetting core.hooksPath never reaches
  # existing projects; their copy silently deletes a configured hook boundary
  # on every setup run. Migration is a warning here because Touchstone never
  # rewrites project-owned files silently.
  if [ -f "$project_dir/setup.sh" ] \
    && grep -q 'unset-all core\.hooksPath' "$project_dir/setup.sh"; then
    tk_warn "setup.sh contains the legacy core.hooksPath reset — running it deletes a configured hook boundary"
    tk_dim "  Fix: re-sync your project-owned setup.sh hook section from templates/setup.sh"
    tk_dim "  (the fixed template preserves core.hooksPath instead of unsetting it)"
    issues=$((issues + 1))
  fi

  # 2c. Legacy CI shape (advisory only — never counted as an issue).
  # TERMINAL SCOPE (PR #668, rounds 1-10): doctor fingerprints the file.
  # Only a byte-identical copy of a starter workflow Touchstone itself
  # shipped counts as legacy — every claim in the warning is then true by
  # construction. ANY edit (added triggers, jobs, comments, filters) makes
  # the file project-customized and doctor says nothing: static analysis
  # of arbitrary project-owned YAML in shell demonstrably cannot converge.
  local ci_workflow="$project_dir/.github/workflows/validate.yml"
  if [ -f "$ci_workflow" ]; then
    # shellcheck source=../lib/sha256.sh
    source "$TOUCHSTONE_ROOT/lib/sha256.sh"
    local ci_fingerprint=""
    ci_fingerprint="$(touchstone_sha256_file "$ci_workflow" 2>/dev/null || true)"
    case "$ci_fingerprint" in
      8567c597e21da543f6542ba10c3f41cfc8d69a3be3959ccf4e4a05fee6abd6ef | \
        5b599e26ff5bcc02ee8c0626cabdd3be7c30e0885ad72c6dd1408139c5dec9aa)
        # v1 (PR #43) and v2 (PR #434) of the pre-lean starter.
        tk_warn "CI validate.yml is the unmodified legacy Touchstone starter (push + PR triggers, no concurrency)"
        tk_dim "  Cost: superseded review heads and already-verified default-branch pushes each bill a full run"
        tk_dim "  Fix: adopt the lean starter — PR-only trigger, PR-numbered concurrency, cancellation:"
        tk_dim "  https://github.com/autumngarage/touchstone/blob/main/templates/ci/github-validate.yml"
        ;;
    esac
  fi

  # 3. Manifest files present?
  if [ -f "$project_dir/.touchstone-manifest" ]; then
    local missing=0 line
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [ -z "$line" ] && continue
      case "$line" in \#*) continue ;; esac
      if [ ! -e "$project_dir/$line" ]; then
        tk_fail "manifest file missing: $line"
        missing=$((missing + 1))
      fi
    done < "$project_dir/.touchstone-manifest"
    if [ "$missing" -eq 0 ]; then
      tk_ok "manifest files all present"
    else
      tk_dim "  Fix: touchstone init  (reconciles missing files)"
      issues=$((issues + missing))
    fi
  else
    tk_warn ".touchstone-manifest missing"
    tk_dim "  Fix: touchstone init"
    issues=$((issues + 1))
  fi

  # 4. Scripts executable?
  if [ -d "$project_dir/scripts" ]; then
    local not_executable=0 script
    for script in "$project_dir/scripts/"*.sh; do
      [ -f "$script" ] || continue
      if [ ! -x "$script" ]; then
        tk_fail "not executable: scripts/$(basename "$script")"
        not_executable=$((not_executable + 1))
      fi
    done
    if [ "$not_executable" -eq 0 ]; then
      tk_ok "scripts are executable"
    else
      tk_dim "  Fix: chmod +x $project_dir/scripts/*.sh"
      issues=$((issues + not_executable))
    fi
  fi

  # 5. Registered in ~/.touchstone-projects?  Informational — 'touchstone update-all'
  # and 'touchstone list' depend on it, but the repo is still functionally gated.
  local projects_file="$HOME/.touchstone-projects"
  if [ -f "$projects_file" ] && grep -qxF "$project_dir" "$projects_file" 2>/dev/null; then
    tk_ok "registered in ~/.touchstone-projects"
  else
    tk_dim "not in ~/.touchstone-projects (touchstone update-all won't update this project)"
    tk_dim "  Fix: echo \"$project_dir\" >> $projects_file"
  fi

  # 6. Required PR-visible review policy.
  local review_policy_file=""
  if [ -f "$project_dir/.touchstone-review.toml" ]; then
    review_policy_file="$project_dir/.touchstone-review.toml"
    tk_ok ".touchstone-review.toml present"
  elif [ -f "$project_dir/.codex-review.toml" ]; then
    review_policy_file="$project_dir/.codex-review.toml"
    tk_warn ".codex-review.toml legacy policy in use"
    tk_dim "  Migrate through a PR using: touchstone diff"
  fi
  if [ -n "$review_policy_file" ]; then
    if touchstone_doctor_pr_review_policy_valid "$review_policy_file"; then
      tk_ok "PR-visible exact-head review required"
    else
      tk_fail ".touchstone-review.toml must require and request GitHub Codex review"
      tk_dim "  Compare with: touchstone diff"
      issues=$((issues + 1))
    fi
  else
    tk_fail ".touchstone-review.toml missing"
    issues=$((issues + 1))
  fi

  # 7. Lint reachability. scripts/touchstone-run.sh's lint action is graceful
  # when a linter is absent — "ruff not installed; skipped" and exit 0 — so a
  # green pre-push is compatible with nothing having been linted. Graceful is
  # the right runtime behavior; invisible is not, and no other surface reports
  # it. #737 removed the doctor profile mirror, and this check is deliberately
  # not that: it asks the runner which profile it resolved instead of
  # re-deriving one, so it cannot drift from the dispatcher.
  _touchstone_doctor_check_lint_reachable "$project_dir" || issues=$((issues + 1))

  # 8. Autumn Garage siblings — orientation-only, never blocking.
  # Autumn Garage Doctrine 0001 forbids code imports across the trio, so this
  # check is file-contract only: shell out to the sibling CLI for a version
  # string and look at the project-local marker directory. Absence is normal.
  tk_info "Autumn Garage siblings"
  _touchstone_doctor_check_sibling "$project_dir" cortex   ".cortex"            "brew install autumngarage/cortex/cortex"
  _touchstone_doctor_check_sibling "$project_dir" sentinel ".sentinel"          "brew install autumngarage/sentinel/sentinel"

  echo ""
  if [ "$issues" -eq 0 ]; then
    tk_ok "Project is fully armed."
    echo ""
    return 0
  fi
  tk_warn "$issues issue(s) found. See fixes above, or run: touchstone init"
  echo ""
  return 1
}

# Report whether .touchstone-config assigns a non-empty value to the given key.
# Used to suppress the lint-reachability check when the project has overridden
# the runner's default dispatch — otherwise doctor false-positives on a config
# that never reaches the profile linter at all.
_touchstone_config_has_override() {
  local dir="$1" key="$2"
  [ -f "$dir/.touchstone-config" ] || return 1
  # Match "key = value" where value has at least one non-space character.
  # Skips commented-out lines ("# key=...") and empty assignments ("key=").
  grep -Eq "^[[:space:]]*${key}[[:space:]]*=[[:space:]]*[^[:space:]#]" "$dir/.touchstone-config"
}

# Is the profile's linter actually reachable? `touchstone run lint` exits 0
# when it is not, so this is the only place a project learns that its lint
# gate has been a no-op. Returns 1 when a real gap is found (the caller counts
# it as an issue), 0 otherwise — including when the check does not apply.
#
# The profile comes from `touchstone-run.sh detect`, i.e. the dispatcher's own
# answer. Doctor must never re-implement that resolution: the mirror #737
# removed had to be hand-kept in lock-step with the runner and silently rotted
# when it wasn't.
_touchstone_doctor_check_lint_reachable() {
  local project_dir="$1" runner profile

  runner="$project_dir/scripts/touchstone-run.sh"
  [ -f "$runner" ] || return 0

  # A configured lint_command/validate_command short-circuits the dispatcher
  # entirely (configured_command_for_action), so no profile default runs.
  if _touchstone_config_has_override "$project_dir" lint_command \
    || _touchstone_config_has_override "$project_dir" validate_command; then
    tk_dim "lint: overridden via .touchstone-config"
    return 0
  fi
  # Config-declared targets make the runner dispatch per-target and never use
  # the root profile. Say so rather than reporting a root answer that does not
  # describe what runs — checking each target would require the profile mirror.
  if _touchstone_config_has_override "$project_dir" targets; then
    tk_dim "lint: dispatched per target; verify each with 'touchstone run lint'"
    return 0
  fi

  # The profile is whatever the runner says it is, but the runner has to
  # actually answer. The old pipeline threw the answer's exit status away —
  # head(1) always succeeds — and sent every diagnostic to /dev/null, so an
  # unreadable or syntactically broken scripts/touchstone-run.sh produced an
  # empty profile, fell through the case default, and let doctor call the
  # project healthy while `touchstone run` could not dispatch validation at
  # all (#801 review). Status and output are captured, then checked.
  local detect_output=""
  if ! detect_output="$(cd "$project_dir" && bash "$runner" detect 2>&1)"; then
    tk_warn "scripts/touchstone-run.sh detect failed — 'touchstone run' cannot dispatch validation"
    if [ -n "$detect_output" ]; then
      tk_dim "  $(printf '%s\n' "$detect_output" | tail -1)"
    fi
    tk_dim "  Fix: touchstone init  (reconciles the managed runner)"
    return 1
  fi
  profile="$(printf '%s\n' "$detect_output" | sed -n 's/^project_type=//p' | head -1)"
  if [ -z "$profile" ]; then
    tk_warn "scripts/touchstone-run.sh detect named no project_type — 'touchstone run' cannot dispatch validation"
    tk_dim "  Fix: touchstone init  (reconciles the managed runner)"
    return 1
  fi
  case "$profile" in
    python)
      if command -v ruff >/dev/null 2>&1; then
        tk_ok "ruff: on PATH"
      else
        tk_warn "ruff not on PATH — 'touchstone run lint' skips it and still exits 0"
        tk_dim "  Fix: brew install ruff   (or: uv tool install ruff)"
        return 1
      fi
      ;;
    swift)
      if command -v swift-format >/dev/null 2>&1; then
        tk_ok "swift-format: on PATH"
      else
        tk_warn "swift-format not on PATH — 'touchstone run lint' skips it and still exits 0"
        tk_dim "  Fix: brew install swift-format"
        return 1
      fi
      ;;
    node)
      # Informational, not an issue: a package.json without a lint script is a
      # project decision, not a broken toolchain.
      if [ -f "$project_dir/package.json" ] && grep -q '"lint"[[:space:]]*:' "$project_dir/package.json"; then
        tk_ok "package.json: lint script configured"
      else
        tk_dim "package.json has no 'lint' script — 'touchstone run lint' skips it and still exits 0"
        tk_dim "  Fix: add a \"lint\" entry under \"scripts\" in package.json"
      fi
      ;;
    *)
      # rust ships fmt/clippy with the toolchain, go vet is built in, and
      # generic has no profile linter to be missing.
      :
      ;;
  esac
  return 0
}

# Report presence + version of a sibling CLI in the Autumn Garage trio.
# File-contract only — no code imports, no reading sibling config beyond a
# presence check on the marker directory. Resolve the CLI path once; a 3s
# timeout on the exact executable's version subcommand keeps a hung or broken
# first PATH entry from stalling doctor or falling through to an older install.
# Absence is never an issue (does not touch $issues in the caller); a CLI
# that's missing while the marker directory is present is an unusual state
# worth flagging (tk_warn), still non-blocking.
#
# Always returns 0 so `set -e` in the caller doesn't abort on a missing CLI.
_touchstone_doctor_check_sibling() {
  local project_dir="$1" name="$2" marker_rel="$3" install_hint="$4"
  local marker_state="absent" marker_note resolved=""
  if [ -d "$project_dir/$marker_rel" ]; then
    marker_state="present"
  fi
  marker_note="${marker_rel}/ ${marker_state}"

  resolved="$(command -v "$name" 2>/dev/null || true)"
  if [ -n "$resolved" ]; then
    local version_raw="" version="" probe_rc=0
    local diagnostic_raw="" diagnostic_rc=0 diagnostic=""
    # 3-second wall-clock cap per probe so a hung sibling can't stall doctor.
    # `perl -e alarm` is portable across macOS + Linux without needing GNU timeout.
    # Try `<cli> version` first (cortex convention, Touchstone convention);
    # fall back to `<cli> --version` (Click / argparse default, Sentinel).
    # Both stdout and stderr are captured because Click prints --version to stdout
    # but launcher failures and unknown-subcommand errors go to stderr.
    for probe in "version" "--version"; do
      if version_raw="$(perl -e 'alarm 3; exec @ARGV or die "exec failed: $!\n"' "$resolved" "$probe" 2>&1)"; then
        probe_rc=0
      else
        probe_rc=$?
      fi
      if [ -n "$version_raw" ]; then
        diagnostic_raw="$version_raw"
        diagnostic_rc="$probe_rc"
      fi
      # Health requires both successful execution and a real version reply.
      if [ "$probe_rc" -eq 0 ] \
        && printf '%s' "$version_raw" | grep -Eq '[0-9]+\.[0-9]+(\.[0-9]+)?'; then
        break
      fi
      version_raw=""
    done
    # Extract the first semver-ish token so the output shape is stable even if
    # the sibling's version output wraps the number with other text.
    version="$(printf '%s' "$version_raw" | awk '
      { for (i=1;i<=NF;i++) if (match($i, /[0-9]+\.[0-9]+(\.[0-9]+)?/)) {
          print substr($i, RSTART, RLENGTH); exit
        }
      }
    ')"
    if [ -n "$version" ]; then
      tk_ok "$name $version (installed) — $marker_note"
      return 0
    fi

    diagnostic="$(printf '%s' "$diagnostic_raw" \
      | tr '\r\n\t' '   ' \
      | awk '{ gsub(/[[:space:]]+/, " "); print substr($0, 1, 240) }')"
    tk_warn "$name CLI is unhealthy at $resolved — $marker_note"
    if [ -n "$diagnostic" ]; then
      tk_dim "  version probe failed (exit $diagnostic_rc): $diagnostic"
    else
      tk_dim "  version probe returned no valid version (exit $probe_rc)"
    fi
    return 0
  fi

  if [ "$marker_state" = "present" ]; then
    tk_warn "$name CLI missing but $marker_rel/ present — install: $install_hint"
    return 0
  fi

  tk_dim "$name not installed"
  return 0
}

touchstone_doctor_usage() {
  cat <<'EOF'
Usage: touchstone doctor [--project|--installation]

  (no flag)             Check the current project, or installation health outside a project
  --project             Check project health and delivery policy
  --installation        Check Touchstone installation health

Exit codes:
  0  structural checks passed
  1  broken or incomplete state
  2  invalid arguments
EOF
}

cmd_doctor() {
  local project_mode=false
  local installation_mode=false

  if [ "$#" -eq 0 ]; then
    if touchstone_find_project_root >/dev/null 2>&1 || [ -f "$(pwd)/.touchstone-version" ] || [ -f "$(pwd)/.toolkit-version" ]; then
      project_mode=true
    else
      installation_mode=true
    fi
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) project_mode=true; shift ;;
      --installation) installation_mode=true; shift ;;
      -h|--help)
        touchstone_doctor_usage
        return 0
        ;;
      *) echo "ERROR: unknown argument '$1'" >&2; exit 1 ;;
    esac
  done

  if [ "$project_mode" = true ] && [ "$installation_mode" = true ]; then
    echo "ERROR: use only one of --project or --installation" >&2
    return 2
  fi

  if [ "$project_mode" = true ]; then
    cmd_doctor_project
    return $?
  fi

  local version
  version="$(touchstone_version_str)"
  local issues=0

  tk_header "Touchstone Doctor"

  # Version.
  if [ -n "$version" ]; then
    tk_ok "Version: v${version}"
  else
    tk_fail "Version: MISSING"
    issues=$((issues + 1))
  fi

  # Required tools.
  for tool in git gh bash; do
    if command -v "$tool" >/dev/null 2>&1; then
      tk_ok "$tool: $(command -v "$tool")"
    else
      tk_fail "$tool: MISSING"
      issues=$((issues + 1))
    fi
  done
  # Recommended tools.
  for tool in pre-commit gitleaks shellcheck shfmt; do
    if command -v "$tool" >/dev/null 2>&1; then
      tk_ok "$tool: $(command -v "$tool")"
    else
      tk_warn "$tool: not installed (run setup.sh to install)"
      issues=$((issues + 1))
    fi
  done

  # Optional tools.
  if command -v but >/dev/null 2>&1; then
    tk_ok "but: $(command -v but)"
  else
    tk_dim "but: not installed (optional — GitButler CLI for stacked branches and AI-agent savepoints)"
  fi

  # Registered projects.
  tk_info "Projects"
  local projects_file="$HOME/.touchstone-projects"
  local current_id
  current_id="$(touchstone_current_id)"
  if [ -f "$projects_file" ]; then
    while IFS= read -r project_dir; do
      [ -z "$project_dir" ] && continue
      [[ "$project_dir" == \#* ]] && continue
      if [ -d "$project_dir" ]; then
        local proj_version
        proj_version="$(cat "$project_dir/.touchstone-version" 2>/dev/null | tr -d '[:space:]' || echo "none")"
        local name
        name="$(basename "$project_dir")"
        if [ "$(_status_behind_count "$proj_version" "$current_id" "$project_dir")" = "current" ]; then
          tk_ok "$name — up to date"
        else
          tk_warn "$name — needs update (run: touchstone update-all)"
          issues=$((issues + 1))
        fi
      else
        tk_fail "$project_dir — directory not found"
        issues=$((issues + 1))
      fi
    done < "$projects_file"
  else
    tk_dim "No projects registered yet."
  fi

  # Latest release check.
  tk_info "Latest release"
  local latest
  latest="$(curl -fsSL --max-time 5 \
    "https://api.github.com/repos/autumngarage/touchstone/releases/latest" 2>/dev/null \
    | grep '"tag_name"' | head -1 | sed 's/.*"v\([^"]*\)".*/\1/')" || latest=""
  if [ -n "$latest" ]; then
    if [ "$version" = "$latest" ]; then
      tk_ok "v${latest} — you're current"
    elif touchstone_version_at_least "$latest" "$version"; then
      tk_ok "v${version} — newer than latest GitHub release v${latest}"
    else
      tk_warn "v${latest} available (you have v${version}). Run: brew upgrade touchstone"
      issues=$((issues + 1))
    fi
  else
    tk_dim "Couldn't check (network issue?)"
  fi

  echo ""
  if [ "$issues" -eq 0 ]; then
    tk_ok "All good."
    echo ""
    return 0
  else
    tk_warn "$issues issue(s) found."
    echo ""
    return 1
  fi
}

cmd_list() {
  local projects_file="$HOME/.touchstone-projects"
  local current_id
  current_id="$(touchstone_current_id)"

  tk_header "Registered Projects"

  if [ ! -f "$projects_file" ] || [ ! -s "$projects_file" ]; then
    tk_dim "No projects registered. Run: touchstone new <dir>"
    return
  fi

  while IFS= read -r project_dir; do
    [ -z "$project_dir" ] && continue
    [[ "$project_dir" == \#* ]] && continue
    local name
    name="$(basename "$project_dir")"
    if [ -d "$project_dir" ]; then
      local proj_version
      proj_version="$(cat "$project_dir/.touchstone-version" 2>/dev/null | tr -d '[:space:]' || echo "none")"
      if [ "$(_status_behind_count "$proj_version" "$current_id" "$project_dir")" = "current" ]; then
        tk_ok "$name  ${DIM}$project_dir${RESET}"
      else
        tk_warn "$name  ${DIM}$project_dir${RESET}  ${YELLOW}(needs update)${RESET}"
      fi
    else
      tk_fail "$name  ${DIM}$project_dir${RESET}  ${RED}(not found)${RESET}"
    fi
  done < "$projects_file"
  echo ""
}

cmd_unregister() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: touchstone unregister <project-path-or-name>" >&2
    exit 1
  fi

  local projects_file="$HOME/.touchstone-projects"
  if [ ! -f "$projects_file" ]; then
    tk_fail "No projects file found."
    return 1
  fi

  # Match by full path or basename.
  local matched=false
  local tmp_file
  tmp_file="$(mktemp)"
  while IFS= read -r project_dir; do
    [ -z "$project_dir" ] && continue
    if [ "$project_dir" = "$target" ] || [ "$(basename "$project_dir")" = "$target" ]; then
      tk_ok "Unregistered: $project_dir"
      matched=true
    else
      echo "$project_dir" >> "$tmp_file"
    fi
  done < "$projects_file"
  mv "$tmp_file" "$projects_file"

  if [ "$matched" = false ]; then
    tk_fail "No project matching '$target' found in registry."
    return 1
  fi
}

cmd_diff() {
  tk_header "Template Diff"
  tk_dim "Comparing project files against latest touchstone templates"
  echo ""

  local has_diff=false
  local pairs=(
    "CLAUDE.md:templates/CLAUDE.md"
    "AGENTS.md:templates/AGENTS.md"
    "GEMINI.md:templates/GEMINI.md"
    ".pre-commit-config.yaml:templates/pre-commit-config.yaml"
    ".touchstone-review.toml:templates/touchstone-review.toml"
  )
  if [ ! -f ".touchstone-review.toml" ] && [ -f ".codex-review.toml" ]; then
    pairs+=(".codex-review.toml:templates/touchstone-review.toml")
  fi

  for pair in "${pairs[@]}"; do
    local project_file="${pair%%:*}"
    local template_file="${pair##*:}"
    local template_path="$TOUCHSTONE_ROOT/$template_file"

    if [ ! -f "$project_file" ]; then
      tk_dim "$project_file — not found (skipped)"
      continue
    fi
    if [ ! -f "$template_path" ]; then
      continue
    fi

    if diff -q "$project_file" "$template_path" >/dev/null 2>&1; then
      tk_ok "$project_file — matches template"
    else
      has_diff=true
      echo "${BOLD}--- $project_file (project)${RESET}"
      echo "${BOLD}+++ $template_file (touchstone template)${RESET}"
      diff -u "$project_file" "$template_path" 2>/dev/null | tail -n +3 || true
      echo ""
    fi
  done

  if [ "$has_diff" = false ]; then
    tk_ok "All project-owned files match templates."
  fi
  echo ""
}

cmd_skills() {
  local subcmd="${1:-list}"

  case "$subcmd" in
    list)
      tk_header "Claude Code Skills"

      local found=false

      # Project-level skills.
      if [ -d ".claude/skills" ]; then
        for skill_dir in .claude/skills/*/; do
          [ -d "$skill_dir" ] || continue
          found=true
          local name
          name="$(basename "$skill_dir")"
          local status=""
          if [ -L "$skill_dir" ]; then
            local target
            target="$(readlink "$skill_dir")"
            status="${DIM}symlink → $target${RESET}"
          else
            status="${DIM}local${RESET}"
          fi
          if [ -f "${skill_dir}SKILL.md" ]; then
            printf "  ${GREEN}✓${RESET} ${BOLD}%-25s${RESET} project   %b\n" "$name" "$status"
          else
            printf "  ${RED}✗${RESET} ${BOLD}%-25s${RESET} project   %b ${RED}(missing SKILL.md)${RESET}\n" "$name" "$status"
          fi
        done
      fi

      # Bundle source — Touchstone-owned, propagated to user scope by `touchstone update`.
      # Only the Touchstone source repo has this directory.
      if [ -d "skills" ]; then
        for skill_dir in skills/*/; do
          [ -d "$skill_dir" ] || continue
          found=true
          local name
          name="$(basename "$skill_dir")"
          local status="${DIM}bundle source${RESET}"
          if [ -f "${skill_dir}SKILL.md" ]; then
            printf "  ${GREEN}✓${RESET} ${BOLD}%-25s${RESET} bundle    %b\n" "$name" "$status"
          else
            printf "  ${RED}✗${RESET} ${BOLD}%-25s${RESET} bundle    %b ${RED}(missing SKILL.md)${RESET}\n" "$name" "$status"
          fi
        done
      fi

      # User-level skills.
      if [ -d "$HOME/.claude/skills" ]; then
        for skill_dir in "$HOME/.claude/skills"/*/; do
          [ -d "$skill_dir" ] || continue
          found=true
          local name
          name="$(basename "$skill_dir")"
          local status=""
          if [ -L "$skill_dir" ]; then
            local target
            target="$(readlink "$skill_dir")"
            status="${DIM}symlink → $target${RESET}"
          else
            status="${DIM}standalone (no symlink)${RESET}"
          fi
          if [ -f "${skill_dir}SKILL.md" ]; then
            printf "  ${GREEN}✓${RESET} ${BOLD}%-25s${RESET} user      %b\n" "$name" "$status"
          else
            printf "  ${RED}✗${RESET} ${BOLD}%-25s${RESET} user      %b ${RED}(missing SKILL.md)${RESET}\n" "$name" "$status"
          fi
        done
      fi

      if [ "$found" = false ]; then
        tk_dim "No skills found."
        tk_dim "Project skills:  .claude/skills/<name>/SKILL.md"
        tk_dim "Bundle source:   skills/<name>/SKILL.md (Touchstone source repo)"
        tk_dim "User skills:     ~/.claude/skills/<name>/SKILL.md"
      fi
      echo ""
      ;;

    check)
      tk_header "Skill Validation"

      local issues=0
      local checked=0
      local dirs=()

      if [ -d ".claude/skills" ]; then
        for d in .claude/skills/*/; do [ -d "$d" ] && dirs+=("$d"); done
      fi
      if [ -d "skills" ]; then
        for d in skills/*/; do [ -d "$d" ] && dirs+=("$d"); done
      fi
      if [ -d "$HOME/.claude/skills" ]; then
        for d in "$HOME/.claude/skills"/*/; do [ -d "$d" ] && dirs+=("$d"); done
      fi

      if [ "${#dirs[@]}" -eq 0 ]; then
        tk_dim "No skills found."
        echo ""
        return
      fi

      for skill_dir in "${dirs[@]}"; do
        checked=$((checked + 1))
        local name
        name="$(basename "$skill_dir")"
        local skill_file="${skill_dir}SKILL.md"

        if [ ! -f "$skill_file" ]; then
          tk_fail "$name — missing SKILL.md"
          issues=$((issues + 1))
          continue
        fi

        # Check frontmatter exists.
        if ! head -1 "$skill_file" | grep -q '^---$'; then
          tk_fail "$name — SKILL.md missing frontmatter (no leading ---)"
          issues=$((issues + 1))
          continue
        fi

        tk_ok "$name — valid"
      done

      echo ""
      if [ "$issues" -eq 0 ]; then
        tk_ok "All $checked skills valid."
      else
        tk_warn "$issues/$checked skills have issues."
      fi
      echo ""
      ;;

    *)
      echo "Usage:" >&2
      echo "  touchstone skills           List all skills" >&2
      echo "  touchstone skills check     Validate skill files" >&2
      exit 1
      ;;
  esac
}

cmd_release() {
  source "$TOUCHSTONE_ROOT/lib/release.sh"

  local bump_type="minor"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --major) bump_type="major"; shift ;;
      --minor) bump_type="minor"; shift ;;
      --patch) bump_type="patch"; shift ;;
      --finalize)
        # Recovery entry: tag + publish for a release whose PR merged after
        # the one-command flow stalled at the merge gate.
        if [ -z "${2:-}" ]; then
          echo "Usage: touchstone release --finalize vX.Y.Z" >&2
          exit 1
        fi
        touchstone_release_finalize "$2"
        return
        ;;
      *) echo "Usage: touchstone release [--major|--minor|--patch|--finalize vX.Y.Z]" >&2; exit 1 ;;
    esac
  done

  touchstone_release "$bump_type"
}

cmd_changelog() {
  local count="${1:-10}"
  tk_header "Recent Releases"

  if ! command -v gh >/dev/null 2>&1; then
    tk_fail "gh CLI not installed. Run: brew install gh"
    return 1
  fi

  gh release list --repo autumngarage/touchstone --limit "$count" 2>/dev/null || {
    tk_fail "Couldn't fetch releases (network issue or auth problem)."
    tk_dim "Fallback — recent commits:"
    git -C "$TOUCHSTONE_ROOT" log --oneline -"$count" 2>/dev/null || true
  }
  echo ""
}

cmd_help() {
  tk_header "touchstone — shared engineering starter kit"
  echo "  ${BOLD}Project commands:${RESET}"
  printf "    ${BOLD}touchstone init${RESET} [--no-setup]      Add touchstone to the current project\n"
  printf "    ${BOLD}touchstone init${RESET} --gitbutler       Add optional GitButler workflow setup\n"
  printf "    ${BOLD}touchstone new${RESET} <dir>              Bootstrap a new project from scratch\n"
  printf "    ${BOLD}touchstone detect${RESET}                 Show detected project profile\n"
  printf "    ${BOLD}touchstone run${RESET} <task>             Run lint, typecheck, build, test, or validate\n"
  printf "    ${BOLD}touchstone preflight${RESET}              Run deterministic review preflight checks\n"
  printf "    ${BOLD}touchstone update${RESET}                 Create a branch + commit for touchstone updates\n"
  printf "    ${BOLD}touchstone update${RESET} --in-place      Commit touchstone updates on the current branch\n"
  printf "    ${BOLD}touchstone update${RESET} --dry-run       Preview what would change\n"
  printf "    ${BOLD}touchstone update${RESET} --check         Report whether this project needs update\n"
  printf "    ${BOLD}touchstone update${RESET} --ship          Push, open PR, review, and auto-merge\n"
  printf "    ${BOLD}touchstone update-all${RESET}             Update all registered projects\n"
  printf "    ${BOLD}touchstone update-all${RESET} --ship      Ship registered project updates through PRs\n"
  printf "    ${BOLD}touchstone update-all${RESET} --check     Report which projects need update\n"
  printf "    ${BOLD}touchstone update-all${RESET} --pull-first Pull latest touchstone first\n"
  printf "    ${BOLD}touchstone sync${RESET}                   Deprecated alias for update-all\n"
  printf "    ${BOLD}touchstone diff${RESET}                   Compare project files vs templates\n"
  echo ""
  echo "  ${BOLD}Registry commands:${RESET}"
  printf "    ${BOLD}touchstone list${RESET}                   Show registered projects\n"
  printf "    ${BOLD}touchstone unregister${RESET} <name>      Remove a project from registry\n"
  printf "    ${BOLD}touchstone status${RESET}                 Show status of the current project\n"
  printf "    ${BOLD}touchstone status${RESET} --all           Version distribution across registered projects\n"
  echo ""
  echo "  ${BOLD}Touchstone commands:${RESET}"
  printf "    ${BOLD}touchstone doctor${RESET}                 Check project or installation health\n"
  printf "    ${BOLD}touchstone doctor${RESET} --project       Check per-project health (hooks, manifest, registry)\n"
  printf "    ${BOLD}touchstone doctor${RESET} --installation  Check installation health\n"
  printf "    ${BOLD}touchstone version${RESET}                Show installed version\n"
  printf "    ${BOLD}touchstone changelog${RESET} [N]          Show last N releases (default 10)\n"
  printf "    ${BOLD}touchstone skills${RESET}                 List Claude Code skills\n"
  printf "    ${BOLD}touchstone skills${RESET} check           Validate skill files\n"
  printf "    ${BOLD}touchstone release${RESET} [--patch]      Cut a new touchstone release (via a release PR)\n"
  printf "    ${BOLD}touchstone release${RESET} --finalize vX.Y.Z  Tag + publish after a stalled release PR merges\n"
  printf "    ${BOLD}touchstone help${RESET}                   Show this help\n"
  echo ""
  echo "  ${BOLD}Environment:${RESET}"
  printf "    ${BOLD}--no-auto-sync${RESET}                    Disable project auto-sync for this invocation\n"
  printf "    ${BOLD}TOUCHSTONE_NO_AUTO_UPDATE=1${RESET}        Disable CLI auto-update and project auto-sync\n"
  printf "    ${BOLD}TOUCHSTONE_NO_AUTO_PROJECT_SYNC=1${RESET}  Disable project auto-sync only\n"
  printf "    ${BOLD}TOUCHSTONE_NO_AUTO_PROJECT_SHIP=1${RESET}  Create local sync branches without auto-shipping PRs\n"
  printf "    ${BOLD}TOUCHSTONE_FORCE_OVERLAP=1${RESET}         Force project sync through dirty overlap\n"
  printf "    ${BOLD}TOUCHSTONE_NO_DRIFT_WARNING=1${RESET}      Suppress skipped-sync drift warning\n"
  echo ""
  printf "  Install: ${DIM}brew tap autumngarage/touchstone && brew install touchstone${RESET}\n"
  echo ""
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

touchstone_filtered_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-auto-sync)
      TOUCHSTONE_NO_AUTO_PROJECT_SYNC=1
      export TOUCHSTONE_NO_AUTO_PROJECT_SYNC
      shift
      ;;
    *)
      touchstone_filtered_args+=("$1")
      shift
      ;;
  esac
done
set -- ${touchstone_filtered_args[@]+"${touchstone_filtered_args[@]}"}

COMMAND="${1:-help}"
shift 2>/dev/null || true

# Auto-project-sync runs after command parsing so read-only commands can skip
# it and before dispatch so write-capable commands see current Touchstone files.
if project_root_for_drift="$(touchstone_find_project_root 2>/dev/null)"; then
  project_id_for_drift="$(tr -d '[:space:]' <"$project_root_for_drift/.touchstone-version" 2>/dev/null || true)"
  installed_id_for_drift="$(touchstone_installed_id)"
  # Pass the tree: the 2-arg form is identity-only, so a content-current
  # project with a differing stamp kept emitting [touchstone drift] warnings
  # while update, status, and auto-sync all called it current (PR #787).
  if touchstone_auto_project_sync_should_sync "$project_id_for_drift" "$installed_id_for_drift" "$project_root_for_drift"; then
    touchstone_sync_warn_if_drift_skipped "$project_root_for_drift" "$installed_id_for_drift" || true
  fi
fi
touchstone_auto_project_sync "$COMMAND" "$@" || true

case "$COMMAND" in
  new)          cmd_new "$@" ;;
  init)         cmd_init "$@" ;;
  run)          cmd_run "$@" ;;
  preflight)    cmd_preflight "$@" ;;
  detect)       cmd_detect ;;
  update)       cmd_update "$@" ;;
  update-all)   cmd_update_all "$@" ;;
  migrate-review-config) cmd_retired_review_migration "$@" ;;
  review)       cmd_retired_review "$@" ;;
  review-stats) cmd_retired_review_stats "$@" ;;
  sync)         cmd_sync "$@" ;;
  status)       cmd_status "$@" ;;
  list|ls)      cmd_list ;;
  unregister)   cmd_unregister "$@" ;;
  diff)         cmd_diff ;;
  skills)       cmd_skills "$@" ;;
  changelog)    cmd_changelog "$@" ;;
  release)      cmd_release "$@" ;;
  version|--version) cmd_version ;;
  doctor)       cmd_doctor "$@" ;;
  help|-h|--help) cmd_help ;;
  *)
    printf "${RED}Unknown command: $COMMAND${RESET}\n" >&2
    echo "Run 'touchstone help' for usage." >&2
    exit 1
    ;;
esac
