#!/usr/bin/env bash
#
# touchstone — versioned adoption, validation, tracker, and PR boundary.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -h "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
TOUCHSTONE_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  touchstone validate [--stage enforce|commit] [--json] [--project DIR] [--config FILE]
  touchstone adopt [--check|--dry-run] [arguments]
  touchstone tracker claim [arguments]
  touchstone pr open|status|merge [arguments]
  touchstone policy status [--base BRANCH] [--project DIR] [--json]
  touchstone pr answer PR --comment-id ID --body-file FILE [--fix-commit SHA]
  touchstone pr answer PR --all-resolved-check
  touchstone version
  touchstone upgrade
  touchstone steering install|check|uninstall [--home DIR] [--dry-run]
  touchstone hook branch-guard
EOF
}

COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  validate)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-run.sh" validate "$@"
    ;;
  adopt)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-adopt.sh" "$COMMAND" "$@"
    ;;
  tracker)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-tracker.sh" "$@"
    ;;
  pr)
    # `pr answer` is the reply-and-resolve step: it lives in
    # scripts/respond-review.sh (reply, resolve the thread, re-run the gate)
    # and was unreachable from the installed tool until it had a name here.
    if [ "${1:-}" = answer ]; then
      shift
      # --project DIR is honoured here (the script resolves the repository
      # from its working directory through gh); --json is not an output
      # mode of this operation and is refused by the script's parser.
      ANSWER_PROJECT=""
      ANSWER_ARGS=()
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --project)
            [ "$#" -ge 2 ] && [ -n "$2" ] || {
              echo "ERROR: --project requires a non-empty directory" >&2
              exit 2
            }
            # Absolute against the invoking directory before any cd: a
            # relative operand would otherwise resolve through an exported
            # CDPATH and bind a different checkout.
            case "$2" in
              /*) ANSWER_PROJECT="$2" ;;
              *) ANSWER_PROJECT="$PWD/$2" ;;
            esac
            shift 2
            ;;
          --body-file)
            # Resolved against the invoking directory before any cd, so a
            # relative reply file means what the caller typed.
            [ "$#" -ge 2 ] || {
              echo "ERROR: --body-file requires a path" >&2
              exit 2
            }
            case "$2" in
              /*) ANSWER_ARGS+=("$1" "$2") ;;
              *) ANSWER_ARGS+=("$1" "$PWD/$2") ;;
            esac
            shift 2
            ;;
          *)
            ANSWER_ARGS+=("$1")
            shift
            ;;
        esac
      done
      if [ -n "$ANSWER_PROJECT" ]; then
        cd -- "$ANSWER_PROJECT" || {
          echo "ERROR: --project directory is not accessible: $ANSWER_PROJECT" >&2
          exit 2
        }
        # --project binds the repository: an exported GH_REPO would override
        # gh's local-repository resolution, and exported Git selectors
        # (GIT_DIR, GIT_WORK_TREE, …) would point git at another checkout.
        unset GH_REPO GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES
      fi
      exec bash "$TOUCHSTONE_ROOT/scripts/respond-review.sh" ${ANSWER_ARGS[@]+"${ANSWER_ARGS[@]}"}
    fi
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-pr.sh" "$@"
    ;;
  policy)
    # What GitHub enforces on a branch, from its effective rules -- the one
    # read an agent needs before trusting any merge.
    case "${1:-}" in
      status)
        shift
        exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-pr.sh" policy-status "$@"
        ;;
      *)
        echo "ERROR: unknown policy command '${1:-<none>}'; available: status" >&2
        exit 2
        ;;
    esac
    ;;
  version)
    # The formula's test block and consumers reporting which tool they run
    # both depend on this exact "touchstone v<semver>" shape -- so an
    # unreadable, empty, or malformed VERSION fails loudly instead of
    # printing a shape nothing downstream can use.
    # Edge-trim only: stripping internal whitespace would launder '3 . 0 . 0'
    # into trusted output. Exactly three numeric components, nothing else.
    RELEASED_VERSION="$(head -n 1 "$TOUCHSTONE_ROOT/VERSION")" || {
      echo "ERROR: could not read $TOUCHSTONE_ROOT/VERSION" >&2
      exit 1
    }
    RELEASED_VERSION="${RELEASED_VERSION#"${RELEASED_VERSION%%[![:space:]]*}"}"
    RELEASED_VERSION="${RELEASED_VERSION%"${RELEASED_VERSION##*[![:space:]]}"}"
    case "$RELEASED_VERSION" in
      [0-9]*.[0-9]*.[0-9]*) ;;
      *)
        echo "ERROR: VERSION is not a MAJOR.MINOR.PATCH release number: '$RELEASED_VERSION'" >&2
        exit 1
        ;;
    esac
    if printf '%s\n' "$RELEASED_VERSION" \
      | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
      printf 'touchstone v%s\n' "$RELEASED_VERSION"
    else
      echo "ERROR: VERSION is not a MAJOR.MINOR.PATCH release number: '$RELEASED_VERSION'" >&2
      exit 1
    fi
    ;;
  steering)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-steering-install.sh" "$@"
    ;;
  hook)
    # Agent hooks by name, so a consumer's settings never encode where the
    # tool is installed (Homebrew's libexec on macOS, ~/.touchstone on
    # Windows Git Bash). Stdin (the tool-call JSON) passes straight through.
    HOOK_NAME="${1:-}"
    case "$HOOK_NAME" in
      branch-guard) exec bash "$TOUCHSTONE_ROOT/hooks/branch-guard.sh" ;;
      *)
        echo "ERROR: unknown hook '${HOOK_NAME:-<none>}'; available: branch-guard" >&2
        exit 2
        ;;
    esac
    ;;
  upgrade)
    # Two install kinds, one command. A Homebrew install is upgraded by
    # Homebrew; an install.sh prefix (the non-Homebrew path: Windows Git
    # Bash, Linux) re-runs its installer for the release the tap formula
    # currently records. The install kind is read from where this tree
    # lives, never guessed from the platform.
    # An install.sh prefix is recognised by its layout, not its name:
    # <prefix>/cli/<version> is this tree, and <prefix>/current names a version.
    # A help probe must never upgrade anything: agents probe subcommands
    # with --help before trusting them (cold-start audit, 2026-08-21).
    case "${1:-}" in
      -h | --help | help)
        echo "Usage: touchstone upgrade"
        echo "Upgrades this install the way it was installed: brew upgrade for a Homebrew install, install.sh for an install.sh prefix."
        exit 0
        ;;
    esac
    INSTALL_PREFIX=""
    case "$TOUCHSTONE_ROOT" in
      */cli/*) INSTALL_PREFIX="${TOUCHSTONE_ROOT%/cli/*}" ;;
    esac
    if [ -n "$INSTALL_PREFIX" ] && [ -f "$INSTALL_PREFIX/current" ] \
      && [ "$INSTALL_PREFIX/cli/$(cat "$INSTALL_PREFIX/current")" = "$TOUCHSTONE_ROOT" ]; then
      exec bash "$TOUCHSTONE_ROOT/install.sh" --prefix "$INSTALL_PREFIX" "$@"
    fi
    case "$TOUCHSTONE_ROOT" in
      *)
        # Homebrew owns this tree only if this tree is the formula's libexec;
        # a source checkout on a machine that also has the formula must not
        # trigger `brew upgrade`.
        if command -v brew >/dev/null 2>&1; then
          BREW_OPT="$(brew --prefix touchstone 2>/dev/null || true)"
          if [ -n "$BREW_OPT" ] && [ -d "$BREW_OPT/libexec" ] \
            && [ "$(cd -P "$BREW_OPT/libexec" && pwd)" = "$TOUCHSTONE_ROOT" ]; then
            exec brew upgrade touchstone
          fi
        fi
        echo "ERROR: this touchstone ($TOUCHSTONE_ROOT) is neither a Homebrew install nor an install.sh prefix; upgrade it the way it was installed (a source checkout: git pull)." >&2
        exit 1
        ;;
    esac
    ;;
  update)
    # Compatibility boundary for repositories still carrying the 2.x scripts:
    # their sync guard runs `touchstone update --check` whenever a touchstone
    # is on PATH, and 3.0.0 removing the command broke every vendored
    # open-pr.sh on a machine that upgraded. Touchstone 3 never syncs a
    # repository, so the honest answer is "nothing to do": succeed, say so,
    # and write nothing. Removed when the last 2.x consumer adopts.
    # The first line is the 2.x sentinel its vendored setup.sh and sync guard
    # grep for; the explanation follows on stderr.
    echo "Already up to date."
    echo "touchstone update: nothing to do. Touchstone 3 installs the tool through Homebrew and never writes to a repository; the 2.x scripts here keep working as committed. To move this repository onto the current contract, run: touchstone adopt" >&2
    exit 0
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "ERROR: unknown command '$COMMAND'" >&2
    usage >&2
    exit 2
    ;;
esac
