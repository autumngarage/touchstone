#!/usr/bin/env bash
#
# touchstone — versioned adoption, validation, tracker, and PR boundary.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -h "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
TOUCHSTONE_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  touchstone validate [--stage enforce|commit] [--json] [--project DIR] [--config FILE]
  touchstone adopt [--check|--dry-run] [arguments]
  touchstone tracker claim [arguments]
  touchstone pr open|status|merge [arguments]
  touchstone policy status [--base BRANCH] [--project DIR] [--json]
  touchstone version
  touchstone steering install|check|uninstall [--home DIR] [--dry-run]
EOF
}

COMMAND="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  validate)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-run.sh" validate "$@"
    ;;
  adopt)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-adopt.sh" "$COMMAND" "$@"
    ;;
  tracker)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-tracker.sh" "$@"
    ;;
  pr)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-pr.sh" "$@"
    ;;
  policy)
    # What GitHub enforces on a branch, from its effective rules -- the one
    # read an agent needs before trusting any merge.
    case "${1:-}" in
      status)
        shift
        exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-pr.sh" policy-status "$@"
        ;;
      *)
        echo "ERROR: unknown policy command '${1:-<none>}'; available: status" >&2
        exit 2
        ;;
    esac
    ;;
  version)
    # The formula's test block and consumers reporting which tool they run
    # both depend on this exact "touchstone v<semver>" shape -- so an
    # unreadable, empty, or malformed VERSION fails loudly instead of
    # printing a shape nothing downstream can use.
    # Edge-trim only: stripping internal whitespace would launder '3 . 0 . 0'
    # into trusted output. Exactly three numeric components, nothing else.
    RELEASED_VERSION="$(head -n 1 "$TOUCHSTONE_ROOT/VERSION")" || {
      echo "ERROR: could not read $TOUCHSTONE_ROOT/VERSION" >&2
      exit 1
    }
    RELEASED_VERSION="${RELEASED_VERSION#"${RELEASED_VERSION%%[![:space:]]*}"}"
    RELEASED_VERSION="${RELEASED_VERSION%"${RELEASED_VERSION##*[![:space:]]}"}"
    case "$RELEASED_VERSION" in
      [0-9]*.[0-9]*.[0-9]*) ;;
      *)
        echo "ERROR: VERSION is not a MAJOR.MINOR.PATCH release number: '$RELEASED_VERSION'" >&2
        exit 1
        ;;
    esac
    if printf '%s\n' "$RELEASED_VERSION" \
      | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
      printf 'touchstone v%s\n' "$RELEASED_VERSION"
    else
      echo "ERROR: VERSION is not a MAJOR.MINOR.PATCH release number: '$RELEASED_VERSION'" >&2
      exit 1
    fi
    ;;
  steering)
    exec bash "$TOUCHSTONE_ROOT/scripts/touchstone-steering-install.sh" "$@"
    ;;
  update)
    # Compatibility boundary for repositories still carrying the 2.x scripts:
    # their sync guard runs `touchstone update --check` whenever a touchstone
    # is on PATH, and 3.0.0 removing the command broke every vendored
    # open-pr.sh on a machine that upgraded. Touchstone 3 never syncs a
    # repository, so the honest answer is "nothing to do": succeed, say so,
    # and write nothing. Removed when the last 2.x consumer adopts.
    # The first line is the 2.x sentinel its vendored setup.sh and sync guard
    # grep for; the explanation follows on stderr.
    echo "Already up to date."
    echo "touchstone update: nothing to do. Touchstone 3 installs the tool through Homebrew and never writes to a repository; the 2.x scripts here keep working as committed. To move this repository onto the current contract, run: touchstone adopt" >&2
    exit 0
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "ERROR: unknown command '$COMMAND'" >&2
    usage >&2
    exit 2
    ;;
esac
