homebrew-touchstone/
*.bak
.cortex/.index.json
.cortex/.index/
.cortex/pending/
.cortex/.last-cli-version

# Credentials — never commit secrets while testing providers locally
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
*.p12

# Agent worktrees (parallel agent slices; see principles/agent-swarms.md).
# templates/gitignore ships this rule to every project — touchstone must
# apply it to itself, or its own dirty-tree guards (release, update, sync)
# refuse whenever an agent worktree exists, which is most of the time.
.claude/worktrees/
