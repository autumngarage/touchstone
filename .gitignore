homebrew-touchstone/
*.bak
.cortex/.index.json
.cortex/.index/
.cortex/pending/
.cortex/.last-cli-version

# Credentials — never commit secrets while testing providers locally
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
*.p12

# Agent worktrees (parallel agent slices; see principles/agent-swarms.md).
# Touchstone's own dirty-tree guards refuse whenever an agent worktree
# exists, which is most of the time, so it must apply this rule to itself.
.claude/worktrees/
