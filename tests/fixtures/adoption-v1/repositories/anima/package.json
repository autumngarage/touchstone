{
  "name": "anima",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "npm run workflow:check && npm run verify:local && next dev --turbopack",
    "build": "next build",
    "start": "node scripts/verify-runtime-environment.mjs && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:env": "node scripts/verify-deployment-env.mjs",
    "verify:local": "node scripts/verify-local-environment.mjs",
    "verify": "npm run verify:workflow && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:workflow": "node scripts/verify-repository-policy.mjs",
    "predeploy": "npm run verify:env && npm run verify",
    "vercel-build": "npm run verify:env && node scripts/wait-for-database-migrations.mjs && next build",
    "deploy:preview": "node scripts/reject-manual-deploy.mjs preview",
    "deploy:prod": "node scripts/reject-manual-deploy.mjs production",
    "workflow:check": "node scripts/verify-workflow-policy.mjs --local && npm run verify:workflow",
    "workflow:check:ci": "node scripts/verify-workflow-policy.mjs --ci && npm run verify:workflow",
    "workflow:enforce": "node scripts/configure-github-workflow.mjs",
    "workflow:status": "node scripts/verify-workflow-enforcement.mjs",
    "e2e": "playwright test",
    "db:auth": "node scripts/neon-branch.mjs auth",
    "db:setup": "node scripts/neon-branch.mjs setup",
    "db:status": "node scripts/neon-branch.mjs status",
    "db:refresh": "node scripts/neon-branch.mjs refresh",
    "deployment:configure-databases": "node scripts/configure-deployment-databases.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run workflow:check && npm run verify:local && drizzle-kit migrate",
    "db:migrate:preview": "node scripts/migrate-preview-database.mjs",
    "db:recover-user:production": "node scripts/recover-production-user.mjs",
    "db:backfill-link-previews:production": "tsx --conditions=react-server scripts/backfill-production-link-previews.ts",
    "db:studio": "npm run verify:local && drizzle-kit studio"
  },
  "dependencies": {
    "@4lt7ab/touchstone": "^0.0.10",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@stylexjs/stylex": "^0.19.0",
    "@vercel/blob": "^2.4.1",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.2.12",
    "@playwright/test": "^1.61.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
